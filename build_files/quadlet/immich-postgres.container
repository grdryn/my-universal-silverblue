[Unit]
Description=Immich Postgres database
RequiresMountsFor=/var/srv/immich/postgres

[Container]
Image=ghcr.io/immich-app/postgres:16-vectorchord0.4.3-pgvectors0.2.0@sha256:1a078b237c1d9b420b0ee59147386b4aa60d3a07a8e6a402fc84a57e41b043a4
ContainerName=immich-postgres
Pod=immich.pod
StartWithPod=true
CgroupsMode=enabled
EnvironmentFile=/etc/containers/systemd/immich.env
Secret=source=immich-db-password,type=env,target=POSTGRES_PASSWORD
Volume=/var/srv/immich/postgres:/var/lib/postgresql/data:Z,U
HealthCmd=pg_isready
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=5m
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=60

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
