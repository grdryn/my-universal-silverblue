[Unit]
Description=Caddy reverse proxy
Requires=caddy-acme-certs-bootstrap.service
After=caddy-acme-certs-bootstrap.service

[Container]
Image=docker.io/library/caddy:2.11.9-alpine@sha256:0bbb055bda6793c999bde78b1b5ce3e89f829fb031af2cf50056ea1246559fee
ContainerName=caddy
UserNS=auto
Network=bridge
AddHost=host.containers.internal:host-gateway
PublishPort=443:443/tcp
PublishPort=443:443/udp
Volume=/etc/caddy:/etc/caddy:ro,Z
Volume=/var/lib/caddy/data:/data:Z,U
Volume=/var/lib/caddy/config:/config:Z,U
Secret=source=caddy-cert,type=mount,target=caddy.crt
Secret=source=caddy-key,type=mount,target=caddy.key
HealthCmd=caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=30s
HealthTimeout=10s
ReloadCmd=caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=30

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
