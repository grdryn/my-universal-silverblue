# Pocket ID runtime configuration, installed as
# /etc/containers/systemd/pocket-id.env. Local edits are preserved across
# bootc upgrades by the /etc three-way merge; ENCRYPTION_KEY is supplied by
# the pocket-id-encryption-key Podman secret.
#
# APP_URL must match the public URL passkeys are bound to, and must match
# the site name in /etc/caddy/sites/pocket-id.caddy.

# Public address users open Pocket ID at, without a path.
APP_URL=https://id.example.com

# Trust the client IP that Caddy forwards.
TRUST_PROXY=true

# Uncomment to stop the release check or the daily analytics heartbeat.
# CHECK_DISABLED=true
# ANALYTICS_DISABLED=true
