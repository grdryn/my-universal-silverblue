# Host-managed ACME certificate settings, installed as
# /etc/caddy/acme-cert.env. Local edits are preserved across bootc upgrades
# by the /etc three-way merge.
#
# Keep the Gandi PAT in a separate root-only file; never put its value here.
#
# The cert is shared by every site block in /etc/caddy/sites/. Issue a
# wildcard so all subdomain sites (immich, pocket-id, ...) present a valid
# cert; new sites only need a matching block in /etc/caddy/sites/.
ACME_DOMAIN=*.example.com

# Optional override: nameservers lego queries for the DNS-01 propagation
# check. Left unset, the helper derives the zone's authoritative nameservers
# with dig, avoiding systemd-resolved's cached NXDOMAIN for the challenge
# label.
# ACME_RESOLVERS=ns-129-a.gandi.net,ns-190-b.gandi.net,ns-101-c.gandi.net
ACME_EMAIL=admin@example.com
GANDIV5_PERSONAL_ACCESS_TOKEN_FILE=/etc/caddy/gandi-pat
