[Unit]
Description=Pocket ID OIDC provider

[Container]
Image=ghcr.io/pocket-id/pocket-id:v2@sha256:3ee23895d6a3adb5dd5de801a4fd31fc31b960e6dfbea9b5200e33cf477695eb
ContainerName=pocket-id
UserNS=auto
Network=bridge
PublishPort=1411:1411
EnvironmentFile=/etc/containers/systemd/pocket-id.env
Secret=source=pocket-id-encryption-key,type=env,target=ENCRYPTION_KEY
Volume=pocket-id-data.volume:/app/data:Z,U
HealthCmd=/app/pocket-id healthcheck
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=30s
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=30

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
