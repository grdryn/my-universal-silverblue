[Unit]
Description=Immich Valkey

[Container]
Image=docker.io/valkey/valkey:9@sha256:3ab0eca823ebbf0fe352476ebac330ac9e5f14b592b9a954eab296d341e81b0e
ContainerName=immich-redis
Pod=immich.pod
StartWithPod=true
CgroupsMode=enabled
HealthCmd=redis-cli ping | grep -q PONG
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=30s
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=30

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
