# Host-managed ACME certificate settings, installed as
# /etc/caddy/acme-cert.env. Local edits are preserved across bootc upgrades
# by the /etc three-way merge.
#
# Keep the Gandi PAT in a separate root-only file; never put its value here.
ACME_DOMAIN=photos.example.com
ACME_EMAIL=admin@example.com
GANDIV5_PERSONAL_ACCESS_TOKEN_FILE=/etc/caddy/gandi-pat
