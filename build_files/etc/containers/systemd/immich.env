# Immich runtime configuration, installed as
# /etc/containers/systemd/immich.env. Local edits are preserved across
# bootc upgrades by the /etc three-way merge; DB_PASSWORD is supplied by
# the immich-db-password Podman secret.

# Container runtime settings
TZ=Etc/UTC

# Immich server database settings. Services share pod network namespace.
DB_HOSTNAME=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Immich server Redis settings
REDIS_HOSTNAME=127.0.0.1
REDIS_PORT=6379

# Machine learning endpoint
IMMICH_MACHINE_LEARNING_URL=http://127.0.0.1:3003

# Postgres initialization settings. These must match DB_USERNAME and
# DB_DATABASE_NAME above. DB_PASSWORD is supplied by a Podman secret.
POSTGRES_USER=postgres
POSTGRES_DB=immich
POSTGRES_INITDB_ARGS=--data-checksums

# Uncomment when database storage uses HDD rather than SSD.
# DB_STORAGE_TYPE=HDD
