[Unit]
Description=Immich Valkey

[Container]
Image=docker.io/valkey/valkey:9@sha256:3add1a336a920ea54770a001ab6feb3da5fceea96a40373a3a2cd469b815f0b7
ContainerName=immich-redis
Pod=immich.pod
StartWithPod=true
CgroupsMode=enabled
HealthCmd=redis-cli ping | grep -q PONG
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=30s
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=30

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
