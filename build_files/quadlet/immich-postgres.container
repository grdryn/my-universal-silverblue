[Unit]
Description=Immich Postgres database
RequiresMountsFor=/var/srv/immich/postgres

[Container]
Image=ghcr.io/immich-app/postgres:18-vectorchord1.1.1-pgvector0.8.5@sha256:b427de4534e09120dd32cba873a2e88f9d026db7a0d813b226c5421c30669546
ContainerName=immich-postgres
Pod=immich.pod
StartWithPod=true
CgroupsMode=enabled
EnvironmentFile=/etc/containers/systemd/immich.env
Secret=source=immich-db-password,type=env,target=POSTGRES_PASSWORD
Volume=/var/srv/immich/postgres:/var/lib/postgresql/data:Z,U
HealthCmd=pg_isready
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=5m
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=60

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
