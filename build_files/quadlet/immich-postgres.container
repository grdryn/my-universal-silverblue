[Unit]
Description=Immich Postgres database
RequiresMountsFor=/var/srv/immich/postgres

[Container]
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
ContainerName=immich-postgres
Pod=immich.pod
StartWithPod=true
CgroupsMode=enabled
EnvironmentFile=/etc/containers/systemd/immich.env
Secret=source=immich-db-password,type=env,target=POSTGRES_PASSWORD
Volume=/var/srv/immich/postgres:/var/lib/postgresql/data:Z,U
HealthCmd=pg_isready
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=5m
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=60

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
