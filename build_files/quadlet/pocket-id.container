[Unit]
Description=Pocket ID OIDC provider

[Container]
Image=ghcr.io/pocket-id/pocket-id:v2@sha256:189e03bb73bb86d7108fe81cbe2237c408cff2176b14cd7a39cc12a2ee8b2762
ContainerName=pocket-id
UserNS=auto
Network=bridge
PublishPort=1411:1411
EnvironmentFile=/etc/containers/systemd/pocket-id.env
Secret=source=pocket-id-encryption-key,type=env,target=ENCRYPTION_KEY
Volume=pocket-id-data.volume:/app/data:Z,U
HealthCmd=/app/pocket-id healthcheck
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=30s
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=30

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
