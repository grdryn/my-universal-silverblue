#!/bin/sh
set -eu

mode="${1:-renew}"
: "${ACME_DOMAIN:?ACME_DOMAIN is required}"
: "${ACME_EMAIL:?ACME_EMAIL is required}"
: "${GANDIV5_PERSONAL_ACCESS_TOKEN_FILE:?GANDIV5_PERSONAL_ACCESS_TOKEN_FILE is required}"

lego_bin="${LEGO_BIN:-/usr/bin/lego}"
acme_server="${ACME_SERVER:-https://acme-v02.api.letsencrypt.org/directory}"

case "$mode" in
    bootstrap|renew)
        ;;
    *)
        echo "unsupported mode: $mode" >&2
        exit 2
        ;;
esac

state_dir="${STATE_DIRECTORY:-/var/lib/caddy-acme-certs}"
lego_dir="$state_dir/lego"

# Lego's DNS-01 propagation check queries recursive nameservers, but
# systemd-resolved caches the NXDOMAIN for _acme-challenge.<zone> for the
# SOA negative TTL (hours for Gandi), so the check times out even after the
# record exists. Verify against the zone's authoritative nameservers
# instead, which have no cache. Override with ACME_RESOLVERS if needed.
zone="${ACME_DOMAIN#\*.}"
resolvers="${ACME_RESOLVERS:-}"
if [ -z "$resolvers" ] && command -v dig >/dev/null 2>&1; then
	resolvers="$(dig +short NS "$zone" | grep -v CNAME | paste -sd ,)"
fi

if [ ! -x "$lego_bin" ]; then
    echo "lego binary not found: $lego_bin" >&2
    exit 1
fi

if [ ! -r "$GANDIV5_PERSONAL_ACCESS_TOKEN_FILE" ]; then
    echo "Gandi PAT file is not readable: $GANDIV5_PERSONAL_ACCESS_TOKEN_FILE" >&2
    exit 1
fi

mkdir -p "$lego_dir"

run_lego() {
	set -- \
		run \
		--accept-tos \
		--email "$ACME_EMAIL" \
		--dns gandiv5 \
		--domains "$ACME_DOMAIN" \
		--path "$lego_dir" \
		--server "$acme_server" \
		--renew-days 30
	if [ -n "$resolvers" ]; then
		set -- "$@" --dns.resolvers "$resolvers"
	fi
	"$lego_bin" "$@"
}

run_lego

# lego replaces "*" with "_" in stored certificate filenames, so a wildcard
# ACME_DOMAIN is stored as _.example.com.crt.
cert_file="$lego_dir/certificates/$(printf '%s' "$ACME_DOMAIN" | tr '*' '_').crt"
key_file="$lego_dir/certificates/$(printf '%s' "$ACME_DOMAIN" | tr '*' '_').key"

if [ ! -r "$cert_file" ] || [ ! -r "$key_file" ]; then
    echo "lego did not produce certificate files for $ACME_DOMAIN" >&2
    exit 1
fi

mkdir -p "$state_dir"
if [ -f "$state_dir/caddy.crt" ] && [ -f "$state_dir/caddy.key" ] \
    && cmp -s "$cert_file" "$state_dir/caddy.crt" \
    && cmp -s "$key_file" "$state_dir/caddy.key"; then
    exit 0
fi

podman secret create --replace caddy-cert "$cert_file"
podman secret create --replace caddy-key "$key_file"

install -m 0644 "$cert_file" "$state_dir/caddy.crt"
install -m 0600 "$key_file" "$state_dir/caddy.key"

if [ "$mode" = renew ]; then
    systemctl restart caddy.service
fi
