[Unit]
Description=Immich Valkey

[Container]
Image=docker.io/valkey/valkey:9@sha256:1c2b25b09f354c66fe994733acdf12fcfd4bdf6f3bd92b88a93a70378d884056
ContainerName=immich-redis
Pod=immich.pod
StartWithPod=true
CgroupsMode=enabled
HealthCmd=redis-cli ping | grep -q PONG
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=30s
HealthTimeout=10s
Pull=missing
Notify=healthy
HealthOnFailure=kill
NoNewPrivileges=true
DropCapability=NET_RAW
StopTimeout=30

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
